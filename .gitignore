# Only what DriveAtlas needs to run is published. Everything else (design sheets, mockups,
# notes, tests, tools, any other .md file) stays in this folder and never goes to GitHub.
# To publish a new file or folder, add it to the allow-list below on purpose.

# 1. Ignore everything at the top level, then allow the app itself.
/*
!/.gitignore
!/.gitattributes
!/README.md
!/LICENSE.md
!/DriveAtlas.vbs
!/DriveAtlas.cmd
!/app/

# 2. Inside app/, allow only what runs.
/app/*
!/app/package.json
!/app/hub/
!/app/ui/
!/app/shared/
!/app/assets/
!/app/scripts/
/app/scripts/*
!/app/scripts/install.ps1

# 3. Never publish these, even inside the folders above.
*.md
!/README.md
!/LICENSE.md
node_modules/
package-lock.json

# Your catalog and backups
data/
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.dabackup
*.dabackup.part
*.db.restore
*.db.before-restore
*.db.restore-check

# Secrets and environment files
.env
.env.*
*.pem
*.key
*.p12
*.pfx
*.keystore
*.jks
secrets/
keystore.properties

# Logs, OS and editor files
*.log
Thumbs.db
desktop.ini
.DS_Store
.vscode/
.idea/
